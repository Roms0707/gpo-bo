{
  "name": "gaming-tournament-backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/check-env.ts && vite --mode staging",
    "dev:staging": "tsx scripts/check-env.ts && VITE_ENV=staging vite --mode staging",
    "dev:production": "tsx scripts/check-env.ts && VITE_ENV=production vite --mode production",
    "build": "tsx scripts/check-env.ts && vite build --mode staging",
    "build:staging": "tsx scripts/check-env.ts && VITE_ENV=staging vite build --mode staging",
    "build:production": "tsx scripts/check-env.ts && VITE_ENV=production vite build --mode production",
    "lint": "eslint .",
    "preview": "tsx scripts/check-env.ts && vite preview",
    "preview:staging": "tsx scripts/check-env.ts && VITE_ENV=staging vite preview",
    "preview:production": "tsx scripts/check-env.ts && VITE_ENV=production vite preview",
    "check:env": "tsx scripts/check-env.ts",
    "check:full": "tsx scripts/verify-migration-env.ts",
    "migrate:check": "tsx scripts/verify-migration-env.ts",
    "migrate:verify": "npm run migrate:check",
    "preinstall": "npm run migrate:check || true",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.39.7",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.22.3",
    "react-zoom-pan-pinch": "^3.7.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
