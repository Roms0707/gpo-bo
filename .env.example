# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co

# Twitch Integration
# Register your application at: https://dev.twitch.tv/console/apps
VITE_TWITCH_CLIENT_ID=your_twitch_client_id
VITE_TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Project Configuration
# IMPORTANT: This variable is NOT used by the backoffice application
# The backoffice always displays 'G-Tournaments' branding with default styling
# This variable is only for front-end tournament platform configuration testing
# Set to 'default' or leave unset to use default configuration
# Set to specific config_id (e.g., 'partner-a') to test that configuration locally
VITE_PROJECT_CONFIG_ID=default

# Galaxy API Configuration
# Contact Galaxy DVE for API credentials
GALAXY_API_KEY="your_galaxy_api_key"
GALAXY_API_SECRET_KEY="your_galaxy_secret_key"
GALAXY_CAMPAIGN_ID="your_campaign_id"
GALAXY_SERVICE_ID="your_service_id"
GALAXY_COUNTRY_CODE="country_code"
GALAXY_LANGUAGE_CODE="language_code"
GALAXY_BASE_URL="https://galaxy-api.galaxydve.com"

# Environment Setup Instructions:
# 1. Copy this file to .env.staging for staging environment
# 2. Copy this file to .env.production for production environment
# 3. Fill in the appropriate values for each environment
# 4. The project loads .env.staging by default in development mode
# 5. Use npm scripts to switch between environments:
#    - npm run dev (uses staging)
#    - npm run dev:staging (explicitly uses staging)
#    - npm run dev:production (uses production)
